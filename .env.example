# ============================================================================
# 文旅MV生产管线 V1.1 配置
# 复制为 .env 后按需填写。全部留空 / FORCE_MOCK=1 时系统在本地兜底模式运行，
# 可完整跑通「建项目 → 写词 → 三模型生曲 → 粗剪 → 精剪 → 多版本导出」，
# 只是歌词、画面描述、音频都是占位产物（界面会显示「模拟」标记）。
# ============================================================================

# 强制所有外部调用走本地兜底（联调期建议保持 1；配好 Key 后改为 0）
FORCE_MOCK=1

# ---------------------------------------------------------------- V1.1 安全与数据隔离
# 访问口令（PRD V1.1 §11）。线上部署【必须】配置，否则任何人都能读数据、触发付费生成。
# 留空 = 不启用（仅限本机开发）。脚本可用请求头 X-Access-Token: <口令> 访问。
ACCESS_PASSWORD=
# 登录 cookie 签名密钥（可选，不配则由口令派生；换口令即全部登出）
SESSION_SECRET=
# 是否允许 mock 占位结果（未配 Key 的模型产出占位音频 / 模板歌词）。生产环境保持 0。
# FORCE_MOCK=1 时自动视为允许。
ALLOW_MOCK=0
# 生成类接口每日费用上限（元，按服务器本地日期累计；0 = 不限）
DAILY_COST_LIMIT=30
# 选型轮参赛模型（PRD V1.1 §7.2；盲听对比只在这些模型间进行）
SELECTION_MODEL_KEYS=mureka,lyria,minimax

# ---------------------------------------------------------------- 大语言模型
# 通义千问 / DeepSeek 等任意 OpenAI 兼容端点
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus

# ---------------------------------------------------------------- 音乐模型
# 参与「同轮多模型对比」的名单（逗号分隔，按顺序出候选）。留空用默认：
#   mureka,eleven,lyria
# 想 4 家一起比：MUSIC_MODEL_KEYS=mureka,eleven,lyria,minimax
# 存量 MiniMax 老账号：MUSIC_MODEL_KEYS=mureka,eleven,minimax
MUSIC_MODEL_KEYS=
# 报价折人民币用的汇率（成本估算显示用）
USD_CNY=7.2

# —— Mureka（platform.mureka.ai）—— $0.045/首，三家里最便宜、国内可直连
#    官方定价：歌词转歌 V7.6 $0.03/首、V8/V9/O2 $0.045/首、9.5 $0.15/首
#    歌词生成 $0.009/首；最低充值 $10（对应 1 并发，$1000 → 5 并发）
#    单曲最长 5m30s；官方明示付费 API 调用产出自带完整商用授权
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_MODEL=auto
# 不想用 auto 时按所选模型填单价（美元/首），用于成本估算
MUREKA_PRICE_PER_SONG_USD=0.045
# 账号实际并发额度（$10 起充档 = 1，$1000 = 5，$3000 = 15）。
# 适配器用它把并发压到额度以内，否则并发 4 的队列会打出一半 429。
MUREKA_CONCURRENCY=1

# —— Eleven Music（ElevenLabs）—— $0.15/分钟，最贵但授权条款最清晰
#    准入：elevenlabs.io 选 ElevenAPI → Developers → API Keys；需国际信用卡（Stripe）
#    3 秒 – 5 分钟；WAV 可选；训练数据经 Merlin/Kobalt/Believe 授权，2026-09 另签 UMG 协议
#    限制：影视/电视/电台/工作室游戏不可用；Free/Starter 档不得分发到流媒体（Creator $22/月起可）
ELEVEN_API_KEY=
ELEVEN_BASE_URL=https://api.elevenlabs.io
ELEVEN_MUSIC_MODEL=music_v2

# —— Google Lyria 3.5（Gemini API）—— $0.08/首，官方 API 里最便宜
#    准入：aistudio.google.com 建 API Key（付费层，无免费额度）；需国际信用卡
#    44.1kHz 立体声；支持自定义歌词（[Verse]/[Chorus]/[Bridge]）；长度靠提示词控（约 2–3 分钟）
#    注意：单轮生成、无法局部改；每首输出带 SynthID 水印；点名歌手音色/版权歌词会被拦
#    连通性：本机实测 generativelanguage.googleapis.com 可直连（TLS 校验通过），
#            但 Google 服务在大陆的连通性不稳定，生产环境建议备一条代理或做降级兜底
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LYRIA_MODEL=lyria-3.5
LYRIA_PRICE_PER_SONG_USD=0.08

# —— MiniMax Music —— ⚠️ 官方托管 API 已对新用户关闭（2026-08-20 起），默认不进对比名单
#    官方公告：付费的音乐生成 / 歌词生成 API 不再对新用户开放；免费版
#    （music-3.0-free / music-2.6-free / music-cover-free）已停止服务。
#    注意 Token Plan 也不含音乐（只覆盖 M3 / M2.7 / image / speech）。
#    官方指向的替代：MiniMax Audio 网页版，或 Hugging Face 开源权重 MiniMaxAI/MiniMax-Music3。
#    要重新启用它，把 MUSIC_MODEL_KEYS 里加上 minimax 即可。
# A. 本地自建推理服务（新用户走这条）：把开源权重包一层 HTTP 服务，
#    契约见 backend/app/adapters/music/minimax.py 顶部注释。进 gpu 队列（串行 1）。
MINIMAX_LOCAL_ENDPOINT=
# B. 官方开放平台（⚠️ 仅存量付费账号仍有效）：国内 api.minimaxi.com / 海外 api.minimax.io
#    老账号保留 $0.15/首（≤5 分钟），歌词生成 $0.01/首。新账号填了也调不通。
#    两者都填时以官方 API 为准。
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MUSIC_MODEL=music-3.0

# ---------------------------------------------------------------- 视觉 / 向量 / 对齐
# 素材打标用的 VLM（Qwen-VL 等 OpenAI 兼容端点）
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=qwen3-vl-plus
# Chinese-CLIP 权重名（装了 torch+transformers 才生效，否则用哈希编码兜底）
CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# 歌词对齐引擎：mock | whisperx | funasr
ALIGN_ENGINE=auto
# 强制对齐用的模型：tiny/base/small/medium/large-v3。
# small 是速度与中文准确率的平衡点（模型约 480MB，首次自动下载到 data/models/）；
# medium 更准但 CPU 上慢一倍多。
ALIGN_MODEL=small
# 模型下载镜像。注意：hf-mirror 的 Xet 分发通道在内网/代理下会握手超时，
# 代码里已强制走经典 CDN（HF_HUB_DISABLE_XET=1），这里只给源站地址。
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------- 热歌监控（monitor.py）
# monitor.py 的 SQLite 数据库。留空则用 backend 数据目录下的 trends.db。
# 想直接复用你自己跑出来的结果，把它指向 04-tourMV/trends.db 的绝对路径。
MONITOR_DB=
# monitor.py 的路径
MONITOR_SCRIPT=
# monitor.py 报告输出目录
MONITOR_REPORTS=
# YouTube Data API（monitor.py 自己读取，这里只是留个位置方便统一管理）
YT_API_KEY=
REGIONS=US,GB,DE,JP,KR
NICHE_KEYWORDS=relaxing,healing,lofi,travel music
AUDIO_DIR=

# ---------------------------------------------------------------- 运行时
DATABASE_URL=
API_CONCURRENCY=4
GPU_CONCURRENCY=1

# 成片回源地址（线上沙箱用；本地留空）
MEDIA_FALLBACK_BASE=

# ---- 逐句配图：文生图模型（镜头确认页可逐句切换模型重出、挑最好的一版）----
# IMAGE_PROVIDER=wanx              # 默认模型：wanx（通义万相）/ seedream / jimeng
# 豆包 Seedream 4.0（火山方舟）：控制台 → API Key 管理；并在「开通管理」里开通 Seedream 模型
ARK_API_KEY=
# SEEDREAM_IMAGE_MODEL=doubao-seedream-4-0-250828
# SEEDREAM_IMAGE_SIZE=2560x1440
# 即梦（火山引擎视觉智能 · 即梦AI-图片生成）：访问控制 → 密钥管理的 AK/SK；并在视觉智能控制台开通即梦能力
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
# JIMENG_IMAGE_MODEL=jimeng_t2i_v40   # 即 req_key；账号开通的是 3.1 就填 jimeng_t2i_v31
# JIMENG_IMAGE_SIZE=2560x1440

# 歌曲默认时长（秒）：新建项目的默认值，也决定歌词写几段几行（120 ≈ 14 行，180 ≈ 19 行）
# SONG_DEFAULT_SECONDS=120

# ---- 记账 / 模型对比台 / 成片分发 ----
# 按 token 计费的模型单价（元/百万 token，[输入, 输出]）。不填用内置价格表；价格变了或加新模型时在这里覆盖
# MODEL_PRICES={"qwen-plus":[0.8,2.0],"qwen3-vl-plus":[1.2,12.0]}
# 写词对比的候选模型（须是 LLM_BASE_URL 下可用的模型名）
# LLM_BENCH_MODELS=qwen-plus,qwen-max,qwen-turbo,qwen-flash
# 成片分发的本地根目录（各渠道文件夹建在它下面）
# DISTRIBUTE_ROOT=D:\09_OPC\文旅MV数字资产
